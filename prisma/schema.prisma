generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  quizzes      Quiz[]
  quizAttempts QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String                @id @default(cuid())
  identifier String
  token      String
  type       VerificationTokenType

  expires DateTime

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([identifier])
}

enum VerificationTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model Quiz {
  id   String  @id @default(cuid())
  slug String? @unique

  title       String
  description String? @db.Text

  thumbnail Image?  @relation(fields: [imageId], references: [id])
  imageId   String?

  language String  @default("en")
  category String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  visibility Visibility @default(PRIVATE)

  editorState Json

  tags String[]

  questionCount Int   @default(0)
  totalPoints   Float @default(0)

  questions Question[]

  attempts QuizAttempt[]

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([visibility])
  @@index([updatedAt])
}

model Question {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  type QuestionType

  title String

  explanation        String? @db.Text
  explanationImage   Image?  @relation("QuestionExplanationImage", fields: [explanationImageId], references: [id])
  explanationImageId String?

  points Float @default(1)

  order Int

  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id])

  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
  @@index([quizId, order])
  @@index([type])
}

enum RuntimeEnvironment {
  PREVIEW
  PRODUCTION
}

enum QuizAttemptMode {
  CLASSIC
  TEST
}

enum QuizAttemptPhase {
  READY
  QUESTION
  RESULT
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AttemptQuestionStatus {
  UNANSWERED
  ANSWERED
  TIMED_OUT
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  quizId String

  quizSnapshot Json

  mode        QuizAttemptMode    @default(CLASSIC)
  environment RuntimeEnvironment @default(PRODUCTION)
  status      QuizAttemptStatus  @default(IN_PROGRESS)
  phase       QuizAttemptPhase   @default(READY)

  currentQuestionIndex Int @default(0)

  timeLimitEnabled Boolean @default(false)
  timeLimitSeconds Int?
  showExplanations Boolean @default(true)
  shuffleQuestions Boolean @default(false)
  shuffleAnswers   Boolean @default(false)

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions AttemptQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([quizId, userId, createdAt])
  @@index([userId, mode, status])
  @@index([lastActivityAt])
}

model AttemptQuestion {
  id        String @id @default(cuid())
  attemptId String

  questionId       String
  orderIndex       Int

  questionSnapshot Json

  status AttemptQuestionStatus @default(UNANSWERED)

  answer     Json?
  evaluation Json?

  earnedPoints Float @default(0)
  maxPoints    Float @default(1)

  flagged Boolean @default(false)
  locked  Boolean @default(false)
  visited Boolean @default(false)

  startedAt              DateTime?
  deadlineAt             DateTime?
  isQuestionTimerRunning Boolean   @default(false)

  hasSeenFeedback Boolean @default(false)

  timeSpentSeconds Int       @default(0)
  answeredAt       DateTime?
  evaluatedAt DateTime?

  updatedAt DateTime @updatedAt

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, orderIndex])
  @@index([attemptId, status])
  @@index([questionId])
}

model Image {
  id  String @id @default(cuid())
  key String

  url String

  caption String?
  alt     String

  ratio String @default("AUTO")

  createdAt DateTime @default(now())

  questions            Question[]
  quizzes              Quiz[]
  explanationQuestions Question[] @relation("QuestionExplanationImage")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_SELECT
  MULTIPLE_SELECT
  TRUE_FALSE

  ORDERING
  MATCH

  TYPE_ANSWER
  FILL_BLANK

  RANGE

  GUESS

  FLASHCARD

  TAP_FIND

  DROPDOWN
}
